<section class="phc-bar">
  <div class="phc-bar__body">
    {{#if isGM}}
    <div class="phc-controls">
      {{#unless started}}
      <button class="phc-btn" type="button" data-action="start-combat"
              data-tooltip="{{localize 'pokemon-hud-combat.hud.startCombat'}}">
        <i class="fa-solid fa-play"></i>
      </button>
      {{/unless}}
      {{#if started}}
      <button class="phc-btn" type="button" data-action="previous-turn"
              data-tooltip="{{localize 'pokemon-hud-combat.hud.previousTurn'}}">
        <i class="fa-solid fa-chevron-left"></i>
      </button>
      <button class="phc-btn" type="button" data-action="next-turn"
              data-tooltip="{{localize 'pokemon-hud-combat.hud.nextTurn'}}">
        <i class="fa-solid fa-chevron-right"></i>
      </button>
      {{/if}}
      <button class="phc-btn" type="button" data-action="roll-all"
              data-tooltip="{{localize 'pokemon-hud-combat.hud.rollAll'}}">
        <i class="fa-solid fa-dice-d20"></i>
      </button>
      <button class="phc-btn" type="button" data-action="toggle-native"
              data-tooltip="{{localize 'pokemon-hud-combat.hud.toggleNative'}}">
        <i class="fa-solid fa-table-list"></i>
      </button>
      <button class="phc-btn phc-btn--danger" type="button" data-action="end-combat"
              data-tooltip="{{localize 'pokemon-hud-combat.hud.endCombat'}}">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
    {{/if}}

    <div class="phc-main">
      <header class="phc-bar__head">
        <div class="phc-logo" aria-hidden="true">
          <i class="fa-solid fa-bolt"></i>
        </div>
        <div class="phc-status">
          <span class="phc-status__label">{{statusLabel}}</span>
          <span class="phc-status__hint">{{localize "pokemon-hud-combat.hud.title"}}</span>
        </div>
      </header>

      <div class="phc-rows">
        {{#if hasGroups}}
          {{#each groups}}
          <article class="phc-card phc-card--{{kind}} phc-card--{{faction}}{{#if active}} phc-card--active{{/if}}{{#if defeated}} phc-card--defeated{{/if}}"
                   data-action="focus-combatant" data-combatant-id="{{combatantId}}">
            <button class="phc-portrait" type="button"
                    data-action="{{#if canPortraitRoll}}roll-initiative{{else}}focus-combatant{{/if}}"
                    data-combatant-id="{{combatantId}}"
                    data-tooltip="{{#if canPortraitRoll}}{{localize 'pokemon-hud-combat.hud.rollHint'}}{{else}}{{name}}{{/if}}">
              <img class="phc-portrait__img" src="{{img}}" alt="{{name}}" />
              {{#if pending}}
                {{#if canPortraitRoll}}
                <span class="phc-portrait__hint" aria-hidden="true">
                  <i class="fa-solid fa-dice-d20"></i>
                </span>
                {{/if}}
                {{#unless rollable}}
                <span class="phc-portrait__lock" aria-hidden="true"
                      data-tooltip="{{localize blockedKey}}">
                  <i class="fa-solid fa-lock"></i>
                </span>
                {{/unless}}
              {{/if}}
              <span class="phc-init{{#unless hasInitiative}} phc-init--pending{{/unless}}">
                {{initiativeText}}
              </span>
            </button>

            {{#if isTrainer}}
            <div class="phc-drawer{{#unless pokemon}} phc-drawer--empty{{/unless}}{{#if pokemon.defeated}} phc-drawer--defeated{{/if}}">
              {{#if pokemon}}
              <span class="phc-drawer__avatar">
                <img class="phc-drawer__img" src="{{pokemon.img}}" alt="{{pokemon.name}}" />
                <span class="phc-drawer__init"
                      data-tooltip="{{localize 'pokemon-hud-combat.hud.rolled' initiative=pokemon.initiativeText}}">
                  {{pokemon.initiativeText}}
                </span>
              </span>
              <div class="phc-drawer__meta">
                <span class="phc-drawer__name">{{pokemon.name}}</span>
                {{#if pokemon.hasHp}}
                <div class="phc-hp {{pokemon.hpClass}}">
                  <span class="phc-hp__fill" style="width: {{pokemon.hpPct}}%"></span>
                </div>
                <span class="phc-drawer__hp">{{pokemon.hpCurrent}} / {{pokemon.hpMax}}</span>
                {{/if}}
              </div>
              {{else}}
              <span class="phc-drawer__none">{{localize "pokemon-hud-combat.hud.emptyDrawer"}}</span>
              {{/if}}
            </div>
            {{/if}}
          </article>
          {{/each}}
        {{else}}
          <div class="phc-empty">
            {{#if present}}{{localize "pokemon-hud-combat.hud.emptyCombat"}}{{else}}{{localize "pokemon-hud-combat.hud.noCombat"}}{{/if}}
          </div>
        {{/if}}
      </div>
    </div>
  </div>
</section>
