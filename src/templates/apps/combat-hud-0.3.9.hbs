<section class="phc-bar">
  <div class="phc-bar__body">
    {{#if isGM}}
    <div class="phc-controls">
      {{#unless started}}
      <button class="phc-btn" type="button" data-action="start-combat"
              data-tooltip="{{localize 'pokemon-hud-combat.hud.startCombat'}}">
        <i class="fa-solid fa-play"></i>
      </button>
      {{/unless}}
      {{#if started}}
      <button class="phc-btn" type="button" data-action="previous-turn"
              data-tooltip="{{localize 'pokemon-hud-combat.hud.previousTurn'}}">
        <i class="fa-solid fa-chevron-left"></i>
      </button>
      <button class="phc-btn" type="button" data-action="next-turn"
              data-tooltip="{{localize 'pokemon-hud-combat.hud.nextTurn'}}">
        <i class="fa-solid fa-chevron-right"></i>
      </button>
      {{/if}}
      <button class="phc-btn" type="button" data-action="roll-all"
              data-tooltip="{{localize 'pokemon-hud-combat.hud.rollAll'}}">
        <i class="fa-solid fa-dice-d20"></i>
      </button>
      <button class="phc-btn" type="button" data-action="toggle-native"
              data-tooltip="{{localize 'pokemon-hud-combat.hud.toggleNative'}}">
        <i class="fa-solid fa-table-list"></i>
      </button>
      <button class="phc-btn phc-btn--danger" type="button" data-action="end-combat"
              data-tooltip="{{localize 'pokemon-hud-combat.hud.endCombat'}}">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
    {{/if}}

    {{#if showRound}}
    <div class="phc-round" data-tooltip="{{localize 'pokemon-hud-combat.hud.roundCounter'}}">
      <i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i>
      <span class="phc-round__value">{{round}}</span>
    </div>
    {{/if}}

    <div class="phc-rows">
      {{#if hasGroups}}
        {{#each groups}}
        <article class="phc-card phc-card--{{faction}}{{#if active}} phc-card--active phc-card--turn-{{faction}}{{/if}}{{#if defeated}} phc-card--defeated{{/if}}"
                 data-action="focus-combatant" data-combatant-id="{{combatantId}}">
          <button class="phc-token" type="button"
                  data-action="{{#if canPortraitRoll}}roll-initiative{{else}}focus-combatant{{/if}}"
                  data-combatant-id="{{combatantId}}"
                  data-tooltip="{{#if canPortraitRoll}}{{localize 'pokemon-hud-combat.hud.rollHint'}}{{else}}{{name}}{{/if}}">
            <img class="phc-token__img" src="{{img}}" alt="" />
            <span class="phc-init{{#unless hasInitiative}} phc-init--pending{{/unless}}">
              {{initiativeText}}
            </span>
            {{#if pending}}
              {{#if canPortraitRoll}}
              <span class="phc-token__hint" aria-hidden="true">
                <i class="fa-solid fa-dice-d20"></i>
              </span>
              {{/if}}
              {{#unless rollable}}
              <span class="phc-token__lock" aria-hidden="true"
                    data-tooltip="{{localize blockedKey}}">
                <i class="fa-solid fa-lock"></i>
              </span>
              {{/unless}}
            {{/if}}
          </button>

          {{#if isTrainer}}
          <div class="phc-drawer{{#unless pokemon}} phc-drawer--empty{{/unless}}{{#if pokemon.defeated}} phc-drawer--defeated{{/if}}">
            {{#if pokemon}}
            <button class="phc-token phc-token--mini" type="button"
                    data-action="{{#if pokemon.canRoll}}roll-initiative{{else}}focus-combatant{{/if}}"
                    data-combatant-id="{{pokemon.combatantId}}"
                    data-tooltip="{{pokemon.name}}">
              <img class="phc-token__img" src="{{pokemon.img}}" alt="" />
              <span class="phc-init phc-init--mini{{#unless pokemon.hasInitiative}} phc-init--pending{{/unless}}">
                {{pokemon.initiativeText}}
              </span>
            </button>
            {{/if}}
          </div>
          {{/if}}
        </article>
        {{/each}}
      {{/if}}
    </div>
  </div>
</section>
