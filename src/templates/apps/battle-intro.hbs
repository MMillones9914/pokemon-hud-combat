{{!--
  Battle intro (VS) screen.
  Left = player trainers, right = rival trainers, a "VS" bar across the middle.

  Two phases:
  - `setup` (GM only): the GM picks the encounter type and types the encounter
    name in the bar on the rival side. Players see nothing at all yet.
  - presentation: once the GM presses "Comenzar combate" everybody sees the
    portraits and the names; the screen closes itself after a few seconds.

  Every portrait lives inside a `.phc-vs__frame`: a vertical rhombus (diamond)
  clipped out of the portrait box and tilted towards its own side of the bar.
--}}
<section class="phc-vs">
  {{#if setup}}
  <div class="phc-vs__picker" data-action="noop">
    <label class="phc-vs__field">
      <span class="phc-vs__field-label">{{localize "pokemon-hud-combat.battleIntro.encounterKind"}}</span>
      <select class="phc-vs__select" data-action="pick-kind">
        {{#each kinds}}
        <option value="{{value}}" {{#if selected}}selected{{/if}} {{#unless implemented}}disabled{{/unless}}>{{label}}</option>
        {{/each}}
      </select>
    </label>
    <button type="button" class="phc-vs__start" data-action="start">
      {{localize "pokemon-hud-combat.battleIntro.start"}}
    </button>
    <button type="button" class="phc-vs__skip" data-action="skip">
      {{localize "pokemon-hud-combat.battleIntro.skip"}}
    </button>
  </div>
  {{/if}}

  <div class="phc-vs__stage">
    <span class="phc-vs__bar"></span>
    <div class="phc-vs__side phc-vs__side--players">
      <ul class="phc-vs__list">
        {{#each players}}
        <li class="phc-vs__actor" data-tooltip="{{name}}">
          <span class="phc-vs__frame">
            <img class="phc-vs__img" src="{{img}}" alt="" />
          </span>
        </li>
        {{/each}}
      </ul>
      {{#if playerTeam}}
      <div class="phc-vs__team">{{playerTeam}}</div>
      {{/if}}
    </div>

    <div class="phc-vs__middle">
      <span class="phc-vs__vs">VS</span>
    </div>

    <div class="phc-vs__side phc-vs__side--rivals">
      <ul class="phc-vs__list">
        {{#each rivals}}
        <li class="phc-vs__actor" data-tooltip="{{name}}">
          <span class="phc-vs__frame">
            <img class="phc-vs__img" src="{{img}}" alt="" />
          </span>
        </li>
        {{/each}}
      </ul>
      {{#if setup}}
      <div class="phc-vs__name-field">
        <span class="phc-vs__name-label">{{localize "pokemon-hud-combat.battleIntro.encounterName"}}</span>
        <input
          class="phc-vs__input"
          type="text"
          data-action="pick-name"
          value="{{encounterName}}"
          placeholder="{{localize "pokemon-hud-combat.battleIntro.encounterNamePlaceholder"}}"
          aria-label="{{localize "pokemon-hud-combat.battleIntro.encounterName"}}"
          spellcheck="false"
          autocomplete="off"
        />
      </div>
      {{else}}
      {{#if encounterName}}
      <div class="phc-vs__team">{{encounterName}}</div>
      {{/if}}
      {{/if}}
    </div>
  </div>

  {{#unless setup}}
  <div class="phc-vs__hint">{{localize "pokemon-hud-combat.battleIntro.skipHint"}}</div>
  {{/unless}}
</section>
